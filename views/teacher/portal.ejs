<!DOCTYPE html>
<html lang="so">
<head>
    <meta charset="UTF-8">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 font-sans">
    <div class="flex min-h-screen">
        <!-- Sidebar-ka Guud -->
        <div class="w-64 bg-gray-900 text-white p-6 space-y-6 flex flex-col justify-between">
            <div>
                <h2 class="text-2xl font-bold text-blue-400 mb-6">🏫 Dalkariim</h2>
                <nav class="space-y-2">
                    <a href="/admin/dashboard" class="block py-2.5 px-4 rounded transition hover:bg-gray-800">📊 Dashboard-ka</a>
                    <a href="/admin/students" class="block py-2.5 px-4 rounded transition hover:bg-gray-800">👨‍🎓 Ardayda</a>
                    <a href="/admin/teachers" class="block py-2.5 px-4 rounded transition hover:bg-gray-800">👩‍🏫 Macallimiinta</a>
                    <a href="/admin/fees" class="block py-2.5 px-4 rounded transition hover:bg-gray-800">💰 Lacagaha / Biilasha</a>
                    <a href="/teacher/portal" class="block py-2.5 px-4 rounded transition bg-gray-800 text-yellow-400 font-semibold">📝 Portalka Macallinka</a>
                </nav>
            </div>
            <div>
                <hr class="border-gray-700 my-4">
                <a href="/login" class="block py-2.5 px-4 rounded transition bg-red-600 hover:bg-red-700 text-center font-semibold">🚪 Ka bax (Logout)</a>
            </div>
        </div>

        <!-- Content-ka Weyn -->
        <div class="flex-1 p-10">
            <h1 class="text-3xl font-bold text-gray-800 mb-6">Portalka Macallinka - Xadirinta & Jadwalka</h1>

            <!-- Grid-ka labada qaybood (Xadirinta & Jadwalka) -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10">
                
                <!-- Qaybta 1: Foomka Xadirinta (Attendance) -->
                <div class="bg-white p-6 rounded-xl shadow-md">
                    <h2 class="text-xl font-bold text-gray-700 mb-4">Diiwaangeli Xadirinta Ardayda</h2>
                    <form action="/teacher/attendance" method="POST" class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700">Magaca Ardayga</label>
                            <input type="text" name="studentName" required class="w-full p-2 border rounded-lg mt-1">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700">Fasalka</label>
                            <input type="text" name="classRoom" required class="w-full p-2 border rounded-lg mt-1">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700">Xaaladda (Status)</label>
                            <select name="status" class="w-full p-2 border rounded-lg mt-1">
                                <option value="Xaadir (Present)">Xaadir (Present)</option>
                                <option value="Maqane (Absent)">Maqane (Absent)</option>
                                <option value="Daahay (Late)">Daahay (Late)</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700">Taariikhda</label>
                            <input type="date" name="date" required class="w-full p-2 border rounded-lg mt-1">
                        </div>
                        <button type="submit" class="w-full bg-blue-600 text-white py-2 rounded-lg font-semibold hover:bg-blue-700">Keydi Xadirinta</button>
                    </form>
                </div>

                <!-- Qaybta 2: Jadwalka Macallimiinta (Teacher Schedule) -->
                <div class="bg-white p-6 rounded-xl shadow-md">
                    <h2 class="text-xl font-bold text-gray-700 mb-4">Jadwalka Fasallada</h2>
                    <div class="space-y-3 text-gray-600">
                        <div class="p-3 bg-gray-50 rounded-lg border flex justify-between items-center">
                            <span><b>Subaxda (08:00 - 09:30):</b> Xisaab (Form 4)</span>
                            <span class="text-sm bg-blue-100 text-blue-800 px-2 py-1 rounded">Fasalka A</span>
                        </div>
                        <div class="p-3 bg-gray-50 rounded-lg border flex justify-between items-center">
                            <span><b>Subaxda (09:40 - 11:00):</b> Physics (Form 3)</span>
                            <span class="text-sm bg-blue-100 text-blue-800 px-2 py-1 rounded">Fasalka B</span>
                        </div>
                        <div class="p-3 bg-gray-50 rounded-lg border flex justify-between items-center">
                            <span><b>Galabta (02:00 - 03:30):</b> Chemistry (Form 2)</span>
                            <span class="text-sm bg-blue-100 text-blue-800 px-2 py-1 rounded">Fasalka C</span>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Liiska Xadirintii la Diiwaangeliyay -->
            <div class="bg-white p-6 rounded-xl shadow-md">
                <h2 class="text-xl font-bold text-gray-700 mb-4">Liiska Xadirinta ee La Keydiyay</h2>
                <table class="w-full border-collapse">
                    <thead>
                        <tr class="bg-gray-200 text-left">
                            <th class="p-3">Magaca Ardayga</th>
                            <th class="p-3">Fasalka</th>
                            <th class="p-3">Xaaladda</th>
                            <th class="p-3">Taariikhda</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (attendanceList && attendanceList.length > 0) { %>
                            <% attendanceList.forEach(item => { %>
                                <tr class="border-b">
                                    <td class="p-3"><%= item.studentName %></td>
                                    <td class="p-3"><%= item.classRoom %></td>
                                    <td class="p-3 font-semibold 
                                        <%= item.status.includes('Xaadir') ? 'text-green-600' : (item.status.includes('Maqane') ? 'text-red-650' : 'text-yellow-600') %>">
                                        <%= item.status %>
                                    </td>
                                    <td class="p-3"><%= item.date %></td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="4" class="p-4 text-center text-gray-500">Weli xadirin lama diiwaangelin.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</body>
</html>