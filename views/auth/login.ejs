<!DOCTYPE html>
<html lang="so">
<head>
    <meta charset="UTF-8">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 flex items-center justify-center h-screen">
    <div class="bg-white p-8 rounded-xl shadow-md w-full max-w-sm">
        <h2 class="text-2xl font-bold mb-6 text-center text-gray-800">Maamulka Login</h2>
        <form action="/login" method="POST" class="space-y-4">
            <div>
                <label class="block text-sm text-gray-600">Username</label>
                <input type="text" name="username" required class="w-full p-2 border rounded-lg mt-1">
            </div>
            <div>
                <label class="block text-sm text-gray-600">Password</label>
                <input type="password" name="password" required class="w-full p-2 border rounded-lg mt-1">
            </div>
            <button type="submit" class="w-full bg-blue-600 text-white py-2 rounded-lg hover:bg-blue-700 font-semibold">Gal</button>
        </form>
        <p class="text-center text-sm text-gray-600 mt-4">Ma leedahay Account? <a href="/register" class="text-blue-600 font-semibold">Is-diiwaangeli</a></p>
    </div>
</body>
</html>