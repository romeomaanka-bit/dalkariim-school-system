<!DOCTYPE html>
<html lang="so">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <style>
        body { 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
            background-color: #f4f7f6; 
            display: flex; 
            justify-content: center; 
            align-items: center; 
            height: 100vh; 
            margin: 0; 
        }
        .card { 
            background: white; 
            padding: 30px; 
            border-radius: 8px; 
            box-shadow: 0 4px 10px rgba(0,0,0,0.1); 
            width: 100%; 
            max-width: 400px; 
        }
        h2 { 
            color: #2c3e50; 
            text-align: center; 
            margin-bottom: 25px; 
            font-size: 24px;
        }
        .form-group { 
            margin-bottom: 20px; 
        }
        label { 
            display: block; 
            margin-bottom: 8px; 
            font-weight: bold; 
            color: #333; 
        }
        input { 
            width: 100%; 
            padding: 10px; 
            border-radius: 4px; 
            border: 1px solid #ccc; 
            box-sizing: border-box; 
        }
        .btn-primary { 
            background-color: #3b82f6; 
            color: white; 
            border: none; 
            padding: 12px; 
            border-radius: 4px; 
            font-weight: bold; 
            cursor: pointer; 
            width: 100%; 
        }
        .btn-primary:hover { 
            background-color: #2563eb; 
        }
        .links { 
            text-align: center; 
            margin-top: 20px; 
        }
        .links a { 
            color: #3b82f6; 
            text-decoration: none; 
            font-size: 14px; 
            margin: 0 5px; 
        }
        .links a:hover { 
            text-decoration: underline; 
        }
        .error { 
            color: #ef4444; 
            font-size: 14px; 
            margin-bottom: 15px; 
            text-align: center; 
        }
    </style>
</head>
<body>
    <div class="card">
        <h2>Soo Celinta Xogta</h2>
        
        <% if (error) { %>
            <div class="error"><%= error %></div>
        <% } %>

        <form action="/forgot-credentials" method="POST">
            <div class="form-group">
                <label>Username-ka Cusub</label>
                <input type="text" name="newUsername" placeholder="Geli username cusub" required>
            </div>
            <div class="form-group">
                <label>Password-ka Cusub</label>
                <input type="password" name="newPassword" placeholder="Geli password cusub" required>
            </div>
            <div class="form-group">
                <label>Xaqiiji Password-ka</label>
                <input type="password" name="confirmPassword" placeholder="Ku celi password-ka" required>
            </div>
            <button type="submit" class="btn-primary">Beddel Xogta</button>
        </form>

        <div class="links">
            <a href="/login">Bogga Login</a> | 
            <a href="/register">Isdiiwaangeli</a>
        </div>
    </div>
</body>
</html>