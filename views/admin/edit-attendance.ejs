<!DOCTYPE html>
<html lang="so">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Poppins', sans-serif; margin: 0; background-color: #f8fafc; display: flex; color: #1e293b; justify-content: center; align-items: center; height: 100vh; }
        .content-card { background: white; padding: 30px; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.05); width: 100%; max-width: 500px; border: 1px solid #f1f5f9; }
        form { display: flex; flex-direction: column; gap: 15px; margin-top: 15px; }
        select, input { padding: 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px; font-family: 'Poppins', sans-serif; }
        button { background-color: #0284c7; color: white; border: none; padding: 12px; border-radius: 8px; cursor: pointer; font-weight: 600; }
        button:hover { background-color: #0369a1; }
    </style>
</head>
<body>
    <div class="content-card">
        <h2>Wax ka beddel Xadirinta</h2>
        <form action="/admin/attendance/update/<%= attendance._id %>" method="POST">
            <label>Fasalka / Maaddada:</label>
            <select name="classRoom" required>
                <% if (classes && classes.length > 0) { %>
                    <% classes.forEach(c => { %>
                        <option value="<%= c.className %>" <%= attendance.subject === c.className ? 'selected' : '' %>><%= c.className %></option>
                    <% }) %>
                <% } %>
            </select>

            <label>Magaca Ardayga:</label>
            <select name="studentName" required>
                <% if (students && students.length > 0) { %>
                    <% students.forEach(s => { %>
                        <option value="<%= s.name %>" <%= attendance.studentName === s.name ? 'selected' : '' %>><%= s.name %></option>
                    <% }) %>
                <% } %>
            </select>

            <label>Xaaladda:</label>
            <select name="status" required>
                <option value="Xaadir" <%= attendance.status === 'Xaadir' ? 'selected' : '' %>>Xaadir (Present)</option>
                <option value="Maqan" <%= attendance.status === 'Maqan' ? 'selected' : '' %>>Maqan (Absent)</option>
            </select>

            <button type="submit">Keydi Isbeddelka</button>
        </form>
    </div>
</body>
</html>