<!DOCTYPE html>
<html lang="so">
<head>
    <meta charset="UTF-8">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 font-sans p-8">
    <div class="max-w-md mx-auto bg-white p-8 rounded-xl shadow-md">
        <h2 class="text-2xl font-bold mb-6 text-gray-800">Wax ka beddel Lacagta</h2>
        <form action="/admin/fees/update/<%= fee._id %>" method="POST" class="space-y-4">
            <div>
                <label class="block text-sm font-medium text-gray-700">Magaca Ardayga</label>
                <input type="text" name="studentName" value="<%= fee.studentName %>" required class="w-full p-2 border rounded-lg mt-1">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700">Lacagta (Amount)</label>
                <input type="number" name="amount" value="<%= fee.amount %>" required class="w-full p-2 border rounded-lg mt-1">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700">Bisha / Taariikhda</label>
                <input type="text" name="month" value="<%= fee.month %>" required class="w-full p-2 border rounded-lg mt-1">
            </div>
            <div class="flex space-x-4">
                <button type="submit" class="w-full bg-blue-600 text-white py-2 rounded-lg font-semibold hover:bg-blue-700">Kaydi Isbeddelka</button>
                <a href="/admin/fees" class="w-full bg-gray-500 text-white py-2 rounded-lg font-semibold text-center hover:bg-gray-600">Jooji</a>
            </div>
        </form>
    </div>
</body>
</html>