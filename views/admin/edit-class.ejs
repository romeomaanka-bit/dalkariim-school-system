<!DOCTYPE html>
<html lang="so">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Poppins', sans-serif; margin: 0; background-color: #f8fafc; display: flex; color: #1e293b; }
        .sidebar { width: 270px; background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); color: white; height: 100vh; position: fixed; padding-top: 25px; box-shadow: 4px 0 15px rgba(0,0,0,0.05); }
        .sidebar h2 { text-align: center; font-size: 22px; margin-bottom: 35px; color: #38bdf8; font-weight: 700; }
        .sidebar ul { list-style: none; padding: 0; margin: 0; }
        .sidebar ul li { margin: 6px 15px; border-radius: 8px; overflow: hidden; }
        .sidebar ul li a { color: #cbd5e1; text-decoration: none; display: block; font-size: 14px; font-weight: 500; padding: 12px 18px; }
        .sidebar ul li:hover { background-color: rgba(56, 189, 248, 0.1); color: #38bdf8; }
        .main-content { margin-left: 270px; padding: 40px; width: calc(100% - 270px); box-sizing: border-box; }
        .form-card { background: white; padding: 25px; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.03); max-width: 600px; border: 1px solid #f1f5f9; }
        .form-group { margin-bottom: 15px; }
        label { display: block; margin-bottom: 6px; font-weight: 500; font-size: 14px; }
        input, textarea { width: 100%; padding: 10px; border-radius: 6px; border: 1px solid #cbd5e1; box-sizing: border-box; font-family: 'Poppins', sans-serif; }
        .btn-primary { background-color: #3b82f6; color: white; border: none; padding: 10px 20px; border-radius: 6px; font-weight: 600; cursor: pointer; }
        .btn-primary:hover { background-color: #2563eb; }
        .btn-secondary { background-color: #64748b; color: white; border: none; padding: 10px 20px; border-radius: 6px; font-weight: 600; cursor: pointer; text-decoration: none; display: inline-block; margin-left: 10px; }
    </style>
</head>
<body>

    <div class="sidebar">
        <h2>Dalkariim School</h2>
        <ul>
            <li><a href="/admin/dashboard">Dashboard</a></li>
            <li><a href="/admin/classes">Maamulka Fasalada</a></li>
            <li><a href="/admin/students">Maamulka Ardayda</a></li>
            <li><a href="/admin/teachers">Macallimiinta</a></li>
            <li><a href="/admin/fees">Lacagaha (Fees)</a></li>
            <li><a href="/admin/attendance">Xadirinta</a></li>
            <li><a href="/admin/timetable">Jadwalka</a></li>
            <li><a href="/login" style="color: #f87171;">Kabax (Logout)</a></li>
        </ul>
    </div>

    <div class="main-content">
        <h1>Wax ka beddelka Fasalka</h1>
        
        <div class="form-card">
            <form action="/admin/classes/edit/<%= classItem._id %>" method="POST">
                <div class="form-group">
                    <label>Magaca Fasalka</label>
                    <input type="text" name="className" value="<%= classItem.className %>" required>
                </div>
                <div class="form-group">
                    <label>Faahfaahin Kooban</label>
                    <textarea name="description"><%= classItem.description %></textarea>
                </div>
                <button type="submit" class="btn-primary">Keydi Isbeddelka</button>
                <a href="/admin/classes" class="btn-secondary">Ka noqo</a>
            </form>
        </div>
    </div>

</body>
</html>