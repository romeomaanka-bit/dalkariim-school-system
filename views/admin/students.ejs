<!DOCTYPE html>
<html lang="so">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #f4f7f6; margin: 0; padding: 20px; }
        .container { max-width: 900px; margin: auto; background: white; padding: 30px; border-radius: 8px; box-shadow: 0 4px 10px rgba(0,0,0,0.1); }
        .header-flex { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
        h2, h3 { color: #2c3e50; margin: 0; }
        .form-row { display: flex; gap: 15px; align-items: flex-end; margin-bottom: 15px; }
        .form-group { flex: 1; }
        label { display: block; margin-bottom: 5px; font-weight: bold; color: #333; }
        input { width: 100%; padding: 10px; border-radius: 4px; border: 1px solid #ccc; box-sizing: border-box; }
        .btn-primary { background-color: #3b82f6; color: white; border: none; padding: 10px 20px; border-radius: 4px; font-weight: bold; cursor: pointer; width: 100%; }
        .btn-primary:hover { background-color: #2563eb; }
        .btn-dashboard { background-color: #64748b; color: white; padding: 8px 15px; border-radius: 4px; text-decoration: none; font-weight: bold; font-size: 14px; }
        .btn-dashboard:hover { background-color: #475569; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th, td { border: 1px solid #ddd; padding: 10px; text-align: left; }
        th { background-color: #3b82f6; color: white; }
        .btn-warning { background-color: #f59e0b; color: white; padding: 5px 10px; border-radius: 4px; text-decoration: none; font-weight: bold; font-size: 13px; display: inline-block; margin-right: 5px; }
        .btn-warning:hover { background-color: #d97706; }
        .btn-danger { background-color: #ef4444; color: white; border: none; padding: 6px 10px; border-radius: 4px; cursor: pointer; font-weight: bold; font-size: 13px; }
        .btn-danger:hover { background-color: #dc2626; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header-flex">
            <h2>Maamulka Ardayda</h2>
            <a href="/admin/dashboard" class="btn-dashboard">Dashboard</a>
        </div>

        <!-- Foomka Ku Darista Ardayga -->
        <form action="/admin/students" method="POST">
            <div class="form-row">
                <div class="form-group">
                    <label>Magaca Ardayga</label>
                    <input type="text" name="name" placeholder="Geli magaca ardayga" required>
                </div>
                <div class="form-group">
                    <label>Fasalka</label>
                    <input type="text" name="classRoom" placeholder="Geli fasalka" required>
                </div>
                <div class="form-group">
                    <label>Nambarka Waalidka</label>
                    <input type="text" name="phone" placeholder="Geli nambarka waalidka" required>
                </div>
            </div>
            <button type="submit" class="btn-primary">Ku Dar Arday</button>
        </form>

        <hr style="margin: 30px 0;">

        <h3>Liiska Ardayda</h3>
        <table>
            <thead>
                <tr>
                    <th>Magaca Ardayga</th>
                    <th>Fasalka</th>
                    <th>Nambarka Waalidka</th>
                    <th>Tallaabo</th>
                </tr>
            </thead>
            <tbody>
                <% if (students && students.length > 0) { %>
                    <% students.forEach(student => { %>
                        <tr>
                            <td><%= student.name %></td>
                            <td><%= student.classRoom %></td>
                            <td><%= student.phone %></td>
                            <td>
                                <a href="/admin/students/edit/<%= student._id %>" class="btn-warning">Beddel</a>
                                <form action="/admin/students/delete/<%= student._id %>" method="POST" style="display:inline;">
                                    <button type="submit" class="btn-danger">Tirtir</button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="4" style="text-align: center; color: #777;">Weli arday lagama diiwaangelin nidaamka.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</body>
</html>