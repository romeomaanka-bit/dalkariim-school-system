<!DOCTYPE html>
<html lang="so">
<head>
    <meta charset="UTF-8">
    <title><%= title %></title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Poppins', sans-serif; background-color: #f1f5f9; margin: 0; padding: 20px; }
        .container { max-width: 1100px; margin: 0 auto; background: white; padding: 30px; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.05); }
        h1, h2 { color: #1e293b; }
        .welcome-banner { background-color: #e0f2fe; color: #0369a1; padding: 15px 20px; border-radius: 10px; font-weight: 600; margin-bottom: 25px; font-size: 16px; display: flex; justify-content: space-between; align-items: center; }
        .admin-nav { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 30px; }
        .admin-nav a { background-color: #0284c7; color: white; padding: 10px 18px; border-radius: 8px; text-decoration: none; font-weight: 500; font-size: 14px; transition: background 0.2s; }
        .admin-nav a:hover { background-color: #0369a1; }
        .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 35px; }
        .stat-card { background: #f8fafc; border: 1px solid #e2e8f0; padding: 20px; border-radius: 12px; text-align: center; }
        .stat-card h3 { margin: 0 0 10px 0; font-size: 14px; color: #64748b; }
        .stat-card p { margin: 0; font-size: 24px; font-weight: 700; color: #0f172a; }
        table { width: 100%; border-collapse: collapse; margin-top: 15px; }
        th, td { border: 1px solid #cbd5e1; padding: 10px; text-align: left; font-size: 14px; }
        th { background-color: #f1f5f9; color: #475569; }
        .section-box { margin-bottom: 40px; }
        .attendance-form { background: #f8fafc; padding: 20px; border-radius: 12px; border: 1px solid #e2e8f0; margin-top: 15px; }
        .form-group { margin-bottom: 12px; }
        label { display: block; font-weight: 600; font-size: 13px; margin-bottom: 5px; color: #475569; }
        select, button { padding: 10px; border-radius: 8px; border: 1px solid #cbd5e1; font-size: 14px; width: 100%; box-sizing: border-box; font-family: 'Poppins', sans-serif; }
        button { background-color: #10b981; color: white; border: none; font-weight: 600; cursor: pointer; margin-top: 5px; }
        button:hover { background-color: #059669; }
    </style>
</head>
<body>
    <div class="container">
        <div class="welcome-banner">
            <span>
                <% if (teacherName) { %>
                    Soo dhawoow, Macallin: <%= teacherName %>
                <% } else { %>
                    Soo dhawoow, Maamule (Admin)
                <% } %>
            </span>
            <a href="/login" style="background-color: #ef4444; color: white; padding: 8px 15px; border-radius: 6px; text-decoration: none; font-size: 13px;">Ka Bax (Logout)</a>
        </div>

        <% if (!teacherName) { %>
            <!-- Admin Navigation Links -->
            <div class="admin-nav">
                <a href="/admin/students">Maamulka Ardayda</a>
                <a href="/admin/teachers">Maamulka Macallimiinta</a>
                <a href="/admin/classes">Maamulka Fasalada</a>
                <a href="/admin/subjects">Maamulka Maadooyinka</a>
                <a href="/admin/timetable">Jadwalka</a>
                <a href="/admin/fees">Lacagaha</a>
                <a href="/admin/attendance">Xadirinta</a>
            </div>

            <!-- Stats Overview for Admin -->
            <div class="stats-grid">
                <div class="stat-card">
                    <h3>Wadarta Ardayda</h3>
                    <p><%= studentsCount %></p>
                </div>
                <div class="stat-card">
                    <h3>Wadarta Macallimiinta</h3>
                    <p><%= teachersCount %></p>
                </div>
                <div class="stat-card">
                    <h3>Wadarta Fasalada</h3>
                    <p><%= classesCount %></p>
                </div>
                <div class="stat-card">
                    <h3>Wadarta Lacagaha</h3>
                    <p><%= feesCount %></p>
                </div>
            </div>

            <!-- Timetable Section (Admin Only) -->
            <div class="section-box">
                <h2>Jadwalka Casharradaada</h2>
                <% if (timetables && timetables.length > 0) { %>
                    <table>
                        <thead>
                            <tr>
                                <th>Maalinta</th>
                                <th>Waqtiga</th>
                                <th>Maadada</th>
                                <th>Fasalka</th>
                                <th>Macallinka</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% timetables.forEach(t => { %>
                                <tr>
                                    <td><%= t.day %></td>
                                    <td><%= t.time %></td>
                                    <td><%= t.subject %></td>
                                    <td><%= t.classRoom %></td>
                                    <td><%= t.teacher %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                <% } else { %>
                    <p style="color: #64748b; font-style: italic;">Wali laguma darin jadwal ku saabsan.</p>
                <% } %>
            </div>
        <% } %>

        <!-- Attendance Section (Visible to Both, but optimized for Teacher's marking) -->
        <div class="section-box">
            <h2>Xadirinta Ardayda</h2>
            
            <% if (teacherName) { %>
                <!-- Form for Teacher to mark attendance -->
                <div class="attendance-form">
                    <h3 style="margin-top: 0; font-size: 16px; color: #1e293b;">Calaamadee Xadirinta Ardayga</h3>
                    <form action="/admin/attendance/mark" method="POST">
                        <input type="hidden" name="teacherName" value="<%= teacherName %>">
                        <div class="form-group">
                            <label>Ardayga:</label>
                            <select name="studentName" required>
                                <% students.forEach(st => { %>
                                    <option value="<%= st.name %>"><%= st.name %> (<%= st.classRoom %>)</option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Fasalka / Maadada:</label>
                            <select name="classRoom" required>
                                <% classes.forEach(c => { %>
                                    <option value="<%= c.className %>"><%= c.className %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Xaaladda (Status):</label>
                            <select name="status" required>
                                <option value="Xadir (Present)">Xadir (Present)</option>
                                <option value="Maqane (Absent)">Maqane (Absent)</option>
                                <option value="Daahay (Late)">Daahay (Late)</option>
                            </select>
                        </div>
                        <button type="submit">Keydi Xadirinta</button>
                    </form>
                </div>
            <% } %>

            <h3 style="margin-top: 25px; font-size: 16px; color: #1e293b;">Liiska Xadirintihii la diiwaangeliyay</h3>
            <% if (attendances && attendances.length > 0) { %>
                <table>
                    <thead>
                        <tr>
                            <th>Magaca Ardayga</th>
                            <th>Fasalka / Maadada</th>
                            <th>Xaaladda</th>
                            <th>Waqtiga</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% attendances.forEach(a => { %>
                            <tr>
                                <td><%= a.studentName %></td>
                                <td><%= a.subject %></td>
                                <td><%= a.status %></td>
                                <td><%= a.time %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            <% } else { %>
                <p style="color: #64748b; font-style: italic;">Wali xadirin lama diiwaangelin.</p>
            <% } %>
        </div>
    </div>
</body>
</html>