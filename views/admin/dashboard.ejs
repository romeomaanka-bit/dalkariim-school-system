<!DOCTYPE html>
<html lang="so">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="bg-light">

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="#">Dalkariim School</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <% if (teacherName) { %>
                        <li class="nav-item">
                            <span class="nav-link text-warning"><i class="fas fa-chalkboard-teacher"></i> Macallin: <%= teacherName %></span>
                        </li>
                    <% } else { %>
                        <li class="nav-item"><a class="nav-link" href="/admin/classes">Fasalada</a></li>
                        <li class="nav-item"><a class="nav-link" href="/admin/students">Ardayda</a></li>
                        <li class="nav-item"><a class="nav-link" href="/admin/teachers">Macallimiinta</a></li>
                        <li class="nav-item"><a class="nav-link" href="/admin/fees">Lacagaha</a></li>
                        <li class="nav-item"><a class="nav-link" href="/admin/timetable">Jadwalka</a></li>
                        <li class="nav-item"><a class="nav-link" href="/admin/subjects">Maadooyinka</a></li>
                        <li class="nav-item"><a class="nav-link" href="/admin/attendance">Xadirinta</a></li>
                    <% } %>
                    <li class="nav-item"><a class="nav-link text-danger" href="/login"><i class="fas fa-sign-out-alt"></i> Ka bax</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Container -->
    <div class="container my-4">
        
        <!-- Welcome / Header Section -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="p-4 bg-white rounded shadow-sm border">
                    <h2 class="text-primary mb-1">Ku soo dhowow Dashboard-ka</h2>
                    <p class="text-muted mb-0"><%= teacherName ? 'Bogga maamulka macallinka ee xadirinta iyo jadwalka.' : 'Halkan waxaad ka maamuli kartaa guud ahaan nidaamka dugsiga.' %></p>
                </div>
            </div>
        </div>

        <!-- Statistics Cards -->
        <% if (!teacherName) { %>
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card bg-primary text-white shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">Ardayda</h5>
                        <h3><%= studentsCount %></h3>
                        <a href="/admin/students" class="text-white text-decoration-none small">Faahfaahin <i class="fas fa-arrow-right"></i></a>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-success text-white shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">Macallimiinta</h5>
                        <h3><%= teachersCount %></h3>
                        <a href="/admin/teachers" class="text-white text-decoration-none small">Faahfaahin <i class="fas fa-arrow-right"></i></a>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-warning text-dark shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">Fasalada</h5>
                        <h3><%= classesCount %></h3>
                        <a href="/admin/classes" class="text-dark text-decoration-none small">Faahfaahin <i class="fas fa-arrow-right"></i></a>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-info text-white shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">Lacagaha la bixiyay</h5>
                        <h3><%= feesCount %></h3>
                        <a href="/admin/fees" class="text-white text-decoration-none small">Faahfaahin <i class="fas fa-arrow-right"></i></a>
                    </div>
                </div>
            </div>
        </div>
        <% } %>

        <!-- Quick Attendance Marking Form for Teachers -->
        <% if (teacherName) { %>
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-secondary text-white">
                <h5 class="mb-0"><i class="fas fa-check-circle"></i> Saxeex Xadirinta Ardayda</h5>
            </div>
            <div class="card-body">
                <form action="/admin/attendance/mark" method="POST">
                    <input type="hidden" name="teacherName" value="<%= teacherName %>">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Ardayga</label>
                            <select name="studentName" class="form-select" required>
                                <option value="">Dooro Ardayga</option>
                                <% students.forEach(s => { %>
                                    <option value="<%= s.name %>"><%= s.name %> (<%= s.classRoom %>)</option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Fasalka / Maadada</label>
                            <select name="classRoom" class="form-select" required>
                                <option value="">Dooro Maadada/Fasalka</option>
                                <% subjects.forEach(sub => { %>
                                    <option value="<%= sub.name %>"><%= sub.name %> (<%= sub.classRoom %>)</option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Xaaladda</label>
                            <select name="status" class="form-select" required>
                                <option value="Present">Xadir (Present)</option>
                                <option value="Absent">Maqane (Absent)</option>
                                <option value="Late">Daahay (Late)</option>
                            </select>
                        </div>
                        <div class="col-md-1 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary w-100">Diiwaangeli</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
        <% } %>

        <!-- Attendance Section -->
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <div id="attendance-section" class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="mb-0">Xadirinta Ardayda</h4>
                    <!-- Badhamada Filter-ka oo soo saaraya sanduuqa xadirinta ee muddada la doortay -->
                    <div>
                        <a href="/admin/dashboard<%= teacherName ? '?teacherName=' + encodeURIComponent(teacherName) + '&filter=week' : '?filter=week' %>#attendance-section" class="btn btn-outline-primary btn-sm <%= typeof currentFilter !== 'undefined' && currentFilter === 'week' ? 'active' : '' %>">Todobaadkii la soo dhaafay</a>
                        <a href="/admin/dashboard<%= teacherName ? '?teacherName=' + encodeURIComponent(teacherName) + '&filter=month' : '?filter=month' %>#attendance-section" class="btn btn-outline-success btn-sm <%= typeof currentFilter !== 'undefined' && currentFilter === 'month' ? 'active' : '' %>">Bishii la soo dhaafay</a>
                        <a href="/admin/dashboard<%= teacherName ? '?teacherName=' + encodeURIComponent(teacherName) : '' %>#attendance-section" class="btn btn-outline-secondary btn-sm <%= typeof currentFilter === 'undefined' || !currentFilter ? 'active' : '' %>">Dhammaan</a>
                    </div>
                </div>

                <!-- Sanduuqa Xadirinta (Attendance Box) -->
                <div class="p-3 border rounded bg-white shadow-sm">
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Magaca Ardayga</th>
                                    <th>Fasalka / Maadada</th>
                                    <th>Xaaladda</th>
                                    <th>Waqtiga / Taariikhda</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (attendances.length > 0) { %>
                                    <% attendances.forEach(a => { %>
                                        <tr>
                                            <td><%= a.studentName %></td>
                                            <td><%= a.subject %></td>
                                            <td>
                                                <% if (a.status === 'Present' || a.status === 'Xadir (Present)') { %>
                                                    <span class="badge bg-success">Xadir (Present)</span>
                                                <% } else if (a.status === 'Absent' || a.status === 'Maqane (Absent)') { %>
                                                    <span class="badge bg-danger">Maqane (Absent)</span>
                                                <% } else if (a.status === 'Late' || a.status === 'Daahay (Late)') { %>
                                                    <span class="badge bg-warning text-dark">Daahay (Late)</span>
                                                <% } else { %>
                                                    <span class="badge bg-secondary"><%= a.status %></span>
                                                <% } %>
                                            </td>
                                            <td><%= a.time || (a.date ? new Date(a.date).toLocaleString() : '') %></td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="4" class="text-center text-muted">Xogta xadirinta lama helin muddadan sanduuqa ku jirta.</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>