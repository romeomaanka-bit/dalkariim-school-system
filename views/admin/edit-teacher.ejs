<!DOCTYPE html>
<html lang="so">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 font-sans flex items-center justify-center h-screen">
    <div class="bg-white rounded-xl shadow p-8 w-full max-w-md">
        <h3 class="text-2xl font-bold text-gray-800 mb-6 text-center">Wax ka beddel Macallinka</h3>
        <form action="/admin/teachers/update/<%= teacher._id %>" method="POST" class="space-y-4">
            <div>
                <label class="block text-sm font-medium text-gray-700">Magaca Macallinka</label>
                <input type="text" name="name" value="<%= teacher.name %>" required class="mt-1 w-full p-2 border rounded-lg focus:ring-green-500 focus:border-green-500">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700">Maaddada uu dhigo</label>
                <input type="text" name="subject" value="<%= teacher.subject %>" required class="mt-1 w-full p-2 border rounded-lg focus:ring-green-500 focus:border-green-500">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700">Teleefanka</label>
                <input type="text" name="phone" value="<%= teacher.phone %>" required class="mt-1 w-full p-2 border rounded-lg focus:ring-green-500 focus:border-green-500">
            </div>
            <div class="flex space-x-4 pt-2">
                <button type="submit" class="flex-1 bg-green-600 text-white py-2 rounded-lg hover:bg-green-700 transition font-semibold">Cusboonaysii</button>
                <a href="/admin/teachers" class="flex-1 bg-gray-300 text-gray-700 py-2 rounded-lg hover:bg-gray-400 transition text-center font-semibold">Ka noqo</a>
            </div>
        </form>
    </div>
</body>
</html>