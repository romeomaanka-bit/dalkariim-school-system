<!DOCTYPE html>
<html lang="so">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Poppins', sans-serif; margin: 0; background-color: #f8fafc; display: flex; color: #1e293b; }
        .sidebar { width: 270px; background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); color: white; height: 100vh; position: fixed; padding-top: 25px; box-shadow: 4px 0 15px rgba(0,0,0,0.05); }
        .sidebar h2 { text-align: center; font-size: 22px; margin-bottom: 35px; color: #38bdf8; font-weight: 700; }
        .sidebar ul { list-style: none; padding: 0; margin: 0; }
        .sidebar ul li { margin: 6px 15px; border-radius: 8px; overflow: hidden; }
        .sidebar ul li a { color: #cbd5e1; text-decoration: none; display: block; font-size: 14px; font-weight: 500; padding: 12px 18px; }
        .sidebar ul li:hover { background-color: rgba(56, 189, 248, 0.1); color: #38bdf8; }
        .main-content { margin-left: 270px; padding: 40px; width: calc(100% - 270px); box-sizing: border-box; }
        
        .content-card { background: white; padding: 25px; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.03); margin-bottom: 30px; border: 1px solid #f1f5f9; }
        form { display: flex; gap: 15px; flex-wrap: wrap; margin-top: 15px; }
        select, input { padding: 10px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px; flex: 1; min-width: 200px; font-family: 'Poppins', sans-serif; }
        button { background-color: #0284c7; color: white; border: none; padding: 10px 20px; border-radius: 8px; cursor: pointer; font-weight: 600; }
        button:hover { background-color: #0369a1; }
        
        table { width: 100%; border-collapse: collapse; margin-top: 15px; }
        th, td { padding: 12px; text-align: left; border-bottom: 1px solid #f1f5f9; font-size: 14px; }
        th { background-color: #f8fafc; color: #64748b; font-weight: 600; }
        
        /* Midabada Xaaladda (Status) */
        .badge-present { color: #16a34a; font-weight: 600; background: #dcfce7; padding: 4px 10px; border-radius: 6px; font-size: 12px; } /* Cagaar */
        .badge-absent { color: #dc2626; font-weight: 600; background: #fee2e2; padding: 4px 10px; border-radius: 6px; font-size: 12px; } /* Guduud */
        
        .action-container { display: flex; gap: 8px; align-items: center; }
    </style>
</head>
<body>

    <div class="sidebar">
        <h2>Dalkariim School</h2>
        <ul>
            <li><a href="/admin/dashboard">Dashboard</a></li>
            <li><a href="/admin/attendance">Xadirinta</a></li>
            <li><a href="/admin/timetable">Jadwalka</a></li>
            <li><a href="/login" style="color: #f87171;">Kabax (Logout)</a></li>
        </ul>
    </div>

    <div class="main-content">
        <h1>Maamulka Xadirinta (Attendance)</h1>

        <!-- Foomka xadirinta -->
        <div class="content-card">
            <h3>Calaamadi Xadirinta Ardayga</h3>
            <form action="/admin/attendance/mark" method="POST">
                <select name="classRoom" required>
                    <option value="">-- Dooro Fasalka --</option>
                    <% if (classes && classes.length > 0) { %>
                        <% classes.forEach(c => { %>
                            <option value="<%= c.className %>"><%= c.className %></option>
                        <% }) %>
                    <% } %>
                </select>

                <select name="studentName" required>
                    <option value="">-- Dooro Ardayga --</option>
                    <% if (students && students.length > 0) { %>
                        <% students.forEach(s => { %>
                            <option value="<%= s.name %>"><%= s.name %> (<%= s.classRoom %>)</option>
                        <% }) %>
                    <% } %>
                </select>

                <select name="status" required>
                    <option value="Xaadir">Xaadir (Present)</option>
                    <option value="Maqan">Maqan (Absent)</option>
                </select>

                <button type="submit">Keydi Xadirinta</button>
            </form>
        </div>

        <!-- Liiska Xadirinta -->
        <div class="content-card">
            <h3>Liiska Xadirinta Ee Diyaarka Ah</h3>
            <% if (attendances && attendances.length > 0) { %>
                <table>
                    <thead>
                        <tr>
                            <th>Magaca Ardayga</th>
                            <th>Fasalka / Maaddada</th>
                            <th>Waqtiga</th>
                            <th>Xaaladda</th>
                            <th>Tallaabo</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% attendances.forEach(att => { %>
                            <tr>
                                <td><%= att.studentName %></td>
                                <td><%= att.subject %></td>
                                <td><%= att.time %></td>
                                <td>
                                    <span class="<%= att.status === 'Xaadir' ? 'badge-present' : 'badge-absent' %>">
                                        <%= att.status %>
                                    </span>
                                </td>
                                <td>
                                    <div class="action-container">
                                        <!-- Badhanka Wax ka beddelka (Edit) oo ka horreeya kan Tirtiridda -->
                                        <a href="/admin/attendance/edit/<%= att._id %>" style="background-color: #0284c7; color: white; padding: 6px 12px; font-size: 12px; border-radius: 6px; text-decoration: none; font-weight: 600;">Beddel</a>
                                        
                                        <!-- Badhanka Tirtiridda -->
                                        <form action="/admin/attendance/delete/<%= att._id %>" method="POST" style="margin:0;">
                                            <button type="submit" style="background-color: #ef4444; padding: 6px 12px; font-size: 12px;">Tirtir</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            <% } else { %>
                <p style="color: #64748b; font-size: 14px;">Weli xadirin lama diiwaangelin.</p>
            <% } %>
        </div>
    </div>

</body>
</html>